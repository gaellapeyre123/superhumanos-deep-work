# Copiar a .env y completar. Nunca subir .env al repo.
NODE_ENV=development
PORT=3001

# Base de datos: "sqlite" (desarrollo) o "mysql" (producción)
DB_CLIENT=sqlite
SQLITE_FILE=./dev.sqlite3
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=cambiar-por-un-string-largo-y-aleatorio
# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# Dominio de la cookie en producción (ej. .gaellapeyre.com). Vacío en local.
COOKIE_DOMAIN=
